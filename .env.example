# API listener
HOST=127.0.0.1
PORT=3000

# Ten minutes. Keep this reasonably gentle on the source site.
REFRESH_INTERVAL_MS=600000

# Browser/source settings
SOURCE_BASE_URL=https://supremevalues.com/mm2
SOURCE_HEADLESS=true
SOURCE_TIMEOUT_MS=90000
SOURCE_DELAY_MS=750
SOURCE_CATEGORIES=sets,uniques,ancients,vintages,chromas,godlies,legendaries,rares,uncommons,commons,pets,misc

# Optional absolute paths. Defaults are under this project.
# BROWSER_PROFILE_DIR=C:\path\to\browser-profile
# CACHE_FILE=C:\path\to\cache.json
# BROWSER_EXECUTABLE_PATH=C:\path\to\chrome.exe

# debug, info, warn, or error
LOG_LEVEL=info
